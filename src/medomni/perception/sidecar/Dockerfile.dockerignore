# Only what the Dockerfile beside this file copies (BuildKit reads <Dockerfile>.dockerignore). The cards' test data,
# weights and runtime state stay out.
*
!pyproject.toml
!src/medomni/__init__.py
!src/medomni/core
!src/medomni/perception
!core/families
!perception/encoders/*/*/card.yaml
!perception/encoders/*/*/adapter.py
!perception/encoders/*/*/Dockerfile
!perception/deployed.yaml
!perception/deployment.yaml
**/__pycache__
**/*.pyc
